{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pfx)",
      "Read(**/*.snk)",
      "Read(**/appsettings.*.local.json)",
      "Read(./secrets/**)",

      "Read(./data/reel/**)",
      "Read(**/exports/**)",
      "Read(**/*-reel.csv)",

      "Read(**/wwwroot/lib/**)",
      "Read(**/*.min.js)",
      "Read(**/*.min.css)",
      "Read(**/*.map)",
      "Read(./design/stitch/**/*.html)"
    ]
  }
}
