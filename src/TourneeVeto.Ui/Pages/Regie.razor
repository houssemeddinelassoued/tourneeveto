@page "/regie"
@page "/regie/{FarmId}"
@using TourneeVeto.Domain.Herd
@using TourneeVeto.Domain.Regie
@using TourneeVeto.Domain.Visits
@using TourneeVeto.Ui.Data
@using TourneeVeto.Ui.Formatting
@inject DemoDataSeeder Seeder
@inject IVisitRepository Repository
@inject TimeProvider TimeProvider
@inject RegieThresholds Thresholds

@* Grille de régie d'une ferme (maquettes design/stitch/*/regie.png). Les motifs et urgences sont calculés par
   DailyActions (TourneeVeto.Domain) ; la page ne fait que charger, filtrer l'affichage et formater les libellés. *@

<PageTitle>Grille de régie — TournéeVéto</PageTitle>

<section class="root" aria-labelledby="regie-title" aria-busy="@(grid is null && error is null ? "true" : "false")">
    <header class="header">
        <h1 class="title" id="regie-title">Grille de régie</h1>
        @if (farm is not null)
        {
            <p class="farm">@farm.Name · @farm.Municipality</p>
        }
        <a class="back" href="">Retour à la tournée</a>
        @if (farm is not null)
        {
            <a class="back" href="@($"fermes/{FarmId}/import")">Importer le troupeau (CSV)</a>
        }
    </header>

    @if (string.IsNullOrEmpty(FarmId))
    {
        <FarmChooser BasePath="regie" />
    }
    else if (error is not null)
    {
        <p class="error" role="alert">@error</p>
    }
    else if (grid is null)
    {
        <p class="status">Chargement de la grille…</p>
    }
    else if (farm is null)
    {
        <p class="error" role="alert">Ferme introuvable.</p>
    }
    else
    {
        @if (visit is null)
        {
            <p class="warning" role="status">Aucune visite prévue aujourd'hui pour cette ferme : la saisie des résultats est désactivée.</p>
        }

        @if (saveError is not null)
        {
            <p class="error" role="alert">@saveError</p>
        }
        else if (saveStatus is not null)
        {
            <p class="saved" role="status">@saveStatus</p>
        }

        @if (grid.UsesDefaultThresholds)
        {
            <p class="warning" role="status">Configuration des seuils invalide : valeurs par défaut utilisées.</p>
        }

        @if (grid.Items.Count == 0)
        {
            <p class="status">Aucune action de régie pour cette visite.</p>
        }
        else
        {
            <div class="filters" role="group" aria-label="Filtrer par motif">
                <button type="button" class="filter" aria-pressed="@Pressed(null)" @onclick="() => filter = null">
                    Tous (@grid.Items.Count)
                </button>
                @foreach (var (action, count) in ActionCounts)
                {
                    <button type="button" class="filter" aria-pressed="@Pressed(action)" @onclick="() => filter = action">
                        @RegieLabels.Action(action) (@count)
                    </button>
                }
            </div>

            <div class="workspace">
                <ul class="cows" role="list">
                    @foreach (var item in VisibleItems)
                    {
                        var primary = item.Motives.FirstOrDefault();
                        <li @key="item.Cow.Id">
                            <CowCard Cow="item.Cow"
                                     Action="primary?.Action"
                                     Urgency="item.Urgency"
                                     Anomaly="item.Anomaly"
                                     DueLabel="@RegieLabels.Due(primary)"
                                     Detail="@OtherMotives(item)"
                                     Metrics="@Metrics(item.Cow)"
                                     Selected="@(item.Cow.Id == Selected?.Cow.Id)"
                                     OnSelect="@(() => selectedId = item.Cow.Id)"
                                     Outcomes="@(visit is not null && primary is not null ? ResultOptions.For(primary.Action) : null)"
                                     Outcome="@(primary is null ? null : RecordFor(item.Cow.Id)?.ResultFor(primary.Action))"
                                     OnOutcome="@(visit is null || primary is null ? default : EventCallback.Factory.Create<ResultOutcome>(this, outcome => SaveResultAsync(item.Cow.Id, primary.Action, outcome)))"
                                     Note="@RecordFor(item.Cow.Id)?.Note"
                                     OnNoteChanged="@(visit is null ? default : EventCallback.Factory.Create<string>(this, note => SaveNoteAsync(item.Cow.Id, note)))" />
                        </li>
                    }
                </ul>

                @* Fiche détaillée (poste) : la vache choisie, sinon la première de la liste affichée. *@
                @if (Selected is { } selected)
                {
                    <aside class="detail" aria-label="Fiche de la vache sélectionnée">
                        <CowDetail Item="selected" />
                    </aside>
                }
            </div>
        }
    }
</section>

@code {
    private Farm? farm;
    private RegieGrid? grid;
    private string? error;
    private RegieAction? filter;
    private string? selectedId;
    private Visit? visit;
    private Dictionary<string, CowVisitRecord> records = [];
    private string? saveStatus;
    private string? saveError;

    /// <summary>Identifiant de la ferme visitée (ex. « F001 ») ; vide sur /regie, qui propose les fermes du jour.</summary>
    [Parameter]
    public string? FarmId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        (farm, grid, error, filter, selectedId, visit, saveStatus, saveError) = (null, null, null, null, null, null, null, null);
        records = [];
        if (string.IsNullOrEmpty(FarmId))
        {
            return;
        }

        try
        {
            await Seeder.EnsureSeededAsync();
            farm = (await Repository.GetFarmsAsync()).FirstOrDefault(candidate => candidate.Id == FarmId);
            IReadOnlyList<Cow> cows = farm is null ? [] : await Repository.GetCowsByFarmAsync(FarmId);
            var today = DateOnly.FromDateTime(TimeProvider.GetLocalNow().DateTime);
            if (farm is not null)
            {
                // Saisie rattachée à la visite du jour ; reprise des saisies déjà enregistrées (story 7.3).
                visit = (await Repository.GetVisitsByDateAsync(today)).FirstOrDefault(candidate => candidate.FarmId == FarmId);
                records = visit is null ? [] : (await Repository.GetVisitRecordsAsync(visit.Id)).ToDictionary(record => record.CowId);
            }

            grid = DailyActions.Compute(cows, today, Thresholds);
        }
        catch (StorageUnavailableException exception)
        {
            error = exception.Message;
        }
    }

    // Filtrage d'affichage uniquement : une vache apparaît sous chacun de ses motifs.
    private IEnumerable<RegieItem> VisibleItems =>
        grid!.Items.Where(item => filter is null || item.Motives.Any(motive => motive.Action == filter));

    private IEnumerable<(RegieAction Action, int Count)> ActionCounts =>
        grid!.Items.SelectMany(item => item.Motives.Select(motive => motive.Action).Distinct())
            .GroupBy(action => action)
            .OrderBy(group => group.Key)
            .Select(group => (group.Key, group.Count()));

    private RegieItem? Selected => VisibleItems.FirstOrDefault(item => item.Cow.Id == selectedId) ?? VisibleItems.FirstOrDefault();

    private string Pressed(RegieAction? action) => filter == action ? "true" : "false";

    private CowVisitRecord? RecordFor(string cowId) => records.GetValueOrDefault(cowId);

    private CowVisitRecord EditableRecord(string cowId) => RecordFor(cowId) ?? CowVisitRecord.Empty(visit!.Id, cowId);

    private Task SaveResultAsync(string cowId, RegieAction action, ResultOutcome outcome) =>
        SaveAsync(EditableRecord(cowId).WithResult(action, outcome, TimeProvider.GetLocalNow()));

    private Task SaveNoteAsync(string cowId, string note) =>
        SaveAsync(EditableRecord(cowId).WithNote(note.Length > CowVisitRecord.MaxNoteLength ? note[..CowVisitRecord.MaxNoteLength] : note, TimeProvider.GetLocalNow()));

    // Enregistrement automatique à chaque saisie (story 7.3) ; en cas d'échec, la saisie reste affichée.
    private async Task SaveAsync(CowVisitRecord record)
    {
        records[record.CowId] = record;
        try
        {
            await Repository.SaveVisitRecordAsync(record);
            (saveError, saveStatus) = (null, $"Enregistré à {record.UpdatedAt:HH:mm}");
        }
        catch (StorageUnavailableException exception)
        {
            (saveError, saveStatus) = (exception.Message, null);
        }
    }

    private static string? OtherMotives(RegieItem item) =>
        item.Motives.Count > 1 ? $"Aussi : {string.Join(", ", item.Motives.Skip(1).Select(motive => RegieLabels.Action(motive.Action)))}." : null;

    private static IReadOnlyList<CowCardMetric> Metrics(Cow cow) =>
    [
        new("Statut", HerdLabels.Status(cow.Status)),
        new("Dernier CCS", cow.LastSccThousands is int scc ? $"{scc} k cellules/mL" : "Aucun contrôle"),
    ];
}
