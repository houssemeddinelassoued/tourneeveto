@page "/regie"
@page "/regie/{FarmId}"
@using TourneeVeto.Domain.Herd
@using TourneeVeto.Domain.Regie
@using TourneeVeto.Domain.Showcase
@using TourneeVeto.Domain.Visits
@using TourneeVeto.Ui.Data
@using TourneeVeto.Ui.Formatting
@inject DemoDataSeeder Seeder
@inject IVisitRepository Repository
@inject TimeProvider TimeProvider
@inject RegieThresholds Thresholds

@* Grille de régie d'une ferme (maquettes design/stitch/*/regie.png). Les motifs et urgences sont calculés par
   DailyActions et la fiche fictive de chaque vache par CowShowcaseBuilder (TourneeVeto.Domain) ; la page ne fait que
   charger, filtrer l'affichage et formater les libellés. Lecteur de boucle, dictée vocale et historique sont simulés. *@

<PageTitle>Grille de régie — TournéeVéto</PageTitle>

<section class="root" aria-labelledby="regie-title" aria-busy="@(grid is null && error is null ? "true" : "false")">
    <header class="header">
        <h1 class="title" id="regie-title">Grille de régie</h1>
        <span class="chip chip--muted">Données fictives</span>
        <a class="back" href="tournee">Retour à la tournée</a>
        @if (farm is not null)
        {
            <a class="back" href="@($"fermes/{FarmId}/import")">Importer le troupeau (CSV)</a>
            <a class="back report-link" href="@($"rapport/{FarmId}")">Voir le rapport de visite</a>
            <a class="back" href="@($"rapport/{FarmId}#recommandations")">Recommandations</a>
        }
    </header>

    @if (string.IsNullOrEmpty(FarmId))
    {
        <FarmChooser BasePath="regie" />
    }
    else if (error is not null)
    {
        <p class="error" role="alert">@error</p>
    }
    else if (grid is null)
    {
        <p class="status">Chargement de la grille…</p>
    }
    else if (farm is null || profile is null)
    {
        <p class="error" role="alert">Ferme introuvable.</p>
    }
    else
    {
        <p class="banner banner--mobile">
            <span class="banner-text"><span class="live" aria-hidden="true"></span>Tablette connectée au troupeau · RFID Active</span>
            <span class="banner-count">@ShowcaseLabels.Count(grid.Items.Count, "acte prévu", "actes prévus")</span>
        </p>
        <p class="banner banner--desktop">
            <span class="banner-text"><span class="live" aria-hidden="true"></span>Base @farm.Name synchronisée en cache local (@ShowcaseLabels.Count(profile.HerdSize, "bovin indexé", "bovins indexés") · mode hors ligne réactif)</span>
            <span class="banner-count">Capteurs colliers &amp; podomètres J-0</span>
        </p>

        <div class="farm-card">
            <span class="farm-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false"><path d="M3 21V9l9-6 9 6v12M3 21h18M9 21v-7h6v7" /></svg>
            </span>
            <div class="farm-info">
                <h2 class="farm-name">@farm.Name</h2>
                <p class="farm-tags">
                    <span class="chip chip--id">@profile.Identifier</span>
                    <span class="chip chip--sector">@Vet.Sector</span>
                </p>
                <p class="farm-meta">@ShowcaseLabels.Count(profile.HerdSize, "vache laitière", "vaches laitières") · @profile.Breed</p>
                <p class="farm-meta farm-meta--mobile">@farm.Municipality · Étable principale n°@profile.Order</p>
                <p class="farm-meta farm-meta--desktop">@farm.Municipality · Moyenne cuve : @profile.Telemetry.ProductionLitersPerDay.ToString("0.0", FrenchCanada) L/j</p>
                <p class="farm-meta farm-meta--desktop">Éleveur réf. : @profile.Farmer (@profile.Phone)</p>
            </div>
            @if (grid.Items.Count > 0)
            {
                <button type="button" class="sort" aria-pressed="@(sortByNumber ? "true" : "false")" @onclick="() => sortByNumber = !sortByNumber">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 7h16M7 12h10M10 17h4" /></svg>
                    <span class="sort-text">Trier</span>
                </button>
                <div class="search">
                    <label class="search-label" for="cow-search">N° boucle ou nom</label>
                    <input id="cow-search" class="search-input" type="search" autocomplete="off" placeholder="N° boucle (ex. 4812) ou nom…"
                           value="@search" @oninput="OnSearch" />
                    <button type="button" class="reader" aria-label="Lire une boucle avec le lecteur RFID (simulé)" @onclick="Simulate">
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 8V5h3M17 5h3v3M20 16v3h-3M7 19H4v-3M8 9h8v6H8z" /></svg>
                    </button>
                </div>
            }
        </div>

        @if (visit is null)
        {
            <p class="warning" role="status">Aucune visite prévue aujourd'hui pour cette ferme : la saisie des résultats est désactivée.</p>
        }

        @if (saveError is not null)
        {
            <p class="error" role="alert">@saveError</p>
        }
        else if (saveStatus is not null)
        {
            <p class="saved" role="status">@saveStatus</p>
        }

        @if (grid.UsesDefaultThresholds)
        {
            <p class="warning" role="status">Configuration des seuils invalide : valeurs par défaut utilisées.</p>
        }

        @if (message is not null)
        {
            <p class="demo" role="status">@message</p>
        }

        @if (grid.Items.Count == 0)
        {
            <p class="status">Aucune action de régie pour cette visite.</p>
        }
        else
        {
            <div class="filters" role="group" aria-label="Filtrer par motif">
                <button type="button" class="filter" aria-pressed="@Pressed(null)" @onclick="() => filter = null">
                    Tous (@grid.Items.Count)
                </button>
                @foreach (var (action, count) in ActionCounts)
                {
                    <button type="button" class="filter" aria-pressed="@Pressed(action)" @onclick="() => filter = action">
                        <span class="dot dot--@action.ToString().ToLowerInvariant()" aria-hidden="true"></span>@RegieLabels.Action(action) (@count)
                    </button>
                }
            </div>

            <div class="workspace">
                <div class="list">
                    <div class="list-head">
                        <h2 class="list-title">Animaux à examiner</h2>
                        <span class="list-date">(Tournée du @ShowcaseLabels.DayMonth(today))</span>
                        <span class="list-urgent">@ShowcaseLabels.Count(grid.Items.Count(item => item.Urgency == Urgency.Urgent), "urgence", "urgences") régie</span>
                    </div>
                    @if (!VisibleItems.Any())
                    {
                        <p class="empty" role="status">Aucune vache ne correspond à « @search ».</p>
                    }
                    <ul class="cows" role="list">
                        @foreach (var item in VisibleItems)
                        {
                            var primary = item.Motives.FirstOrDefault();
                            var show = ShowFor(item);
                            <li @key="item.Cow.Id">
                                <CowCard Cow="item.Cow"
                                         Action="primary?.Action"
                                         Urgency="item.Urgency"
                                         Anomaly="item.Anomaly"
                                         DueLabel="@RegieLabels.Pill(primary, item.Cow)"
                                         Detail="@OtherMotives(item)"
                                         NationalId="@show.NationalId"
                                         Statement="@show.Statement"
                                         Metrics="@Metrics(show)"
                                         Selected="@(item.Cow.Id == Selected?.Cow.Id)"
                                         OnSelect="@(() => selectedId = item.Cow.Id)"
                                         OnHistory="Simulate"
                                         Outcomes="@(visit is not null && primary is not null ? ResultOptions.For(primary.Action) : null)"
                                         Outcome="@(primary is null ? null : RecordFor(item.Cow.Id)?.ResultFor(primary.Action))"
                                         OnOutcome="@(visit is null || primary is null ? default : EventCallback.Factory.Create<ResultOutcome>(this, outcome => SaveResultAsync(item.Cow.Id, primary.Action, outcome)))"
                                         Note="@RecordFor(item.Cow.Id)?.Note"
                                         OnNoteChanged="@(visit is null ? default : EventCallback.Factory.Create<string>(this, note => SaveNoteAsync(item.Cow.Id, note)))" />
                            </li>
                        }
                    </ul>
                </div>

                @* Fiche détaillée (poste) : la vache choisie, sinon la première de la liste affichée. *@
                @if (Selected is { } selected)
                {
                    var selectedPrimary = selected.Motives.FirstOrDefault();
                    <aside class="detail" aria-label="Fiche de la vache sélectionnée">
                        <CowDetail Item="selected"
                                   Show="ShowFor(selected)"
                                   Today="today"
                                   Outcomes="@(visit is not null && selectedPrimary is not null ? ResultOptions.For(selectedPrimary.Action) : null)"
                                   Outcome="@(selectedPrimary is null ? null : RecordFor(selected.Cow.Id)?.ResultFor(selectedPrimary.Action))"
                                   OnOutcome="@(visit is null || selectedPrimary is null ? default : EventCallback.Factory.Create<ResultOutcome>(this, outcome => SaveResultAsync(selected.Cow.Id, selectedPrimary.Action, outcome)))"
                                   Note="@RecordFor(selected.Cow.Id)?.Note"
                                   OnNoteChanged="@(visit is null ? default : EventCallback.Factory.Create<string>(this, note => SaveNoteAsync(selected.Cow.Id, note)))"
                                   OnSimulate="Simulate" />
                    </aside>
                }
            </div>
        }
    }
</section>

@code {
    private static readonly System.Globalization.CultureInfo FrenchCanada = System.Globalization.CultureInfo.GetCultureInfo("fr-CA");

    private Farm? farm;
    private RegieGrid? grid;
    private string? error;
    private RegieAction? filter;
    private string search = string.Empty;
    private string? selectedId;
    private Visit? visit;
    private Dictionary<string, CowVisitRecord> records = [];
    private string? saveStatus;
    private string? saveError;
    private string? message;
    private bool sortByNumber;
    private DateOnly today;
    private FarmShowcase? profile;

    /// <summary>Identifiant de la ferme visitée (ex. « F001 ») ; vide sur /regie, qui propose les fermes du jour.</summary>
    [Parameter]
    public string? FarmId { get; set; }

    /// <summary>Recherche transmise par la barre du haut (« regie/F001?q=4812 ») : préremplit le filtre N° boucle ou nom.</summary>
    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        (farm, grid, error, filter, selectedId, visit, saveStatus, saveError, search) = (null, null, null, null, null, null, null, null, Query ?? string.Empty);
        (profile, message) = (null, null);
        records = [];
        if (string.IsNullOrEmpty(FarmId))
        {
            return;
        }

        try
        {
            await Seeder.EnsureSeededAsync();
            var farms = await Repository.GetFarmsAsync();
            farm = farms.FirstOrDefault(candidate => candidate.Id == FarmId);
            IReadOnlyList<Cow> cows = farm is null ? [] : await Repository.GetCowsByFarmAsync(FarmId);
            today = DateOnly.FromDateTime(TimeProvider.GetLocalNow().DateTime);
            if (farm is not null)
            {
                // Saisie rattachée à la visite du jour ; reprise des saisies déjà enregistrées (story 7.3).
                var todaysVisits = await Repository.GetVisitsByDateAsync(today);
                visit = todaysVisits.FirstOrDefault(candidate => candidate.FarmId == FarmId);
                profile = ShowcaseBuilder.ProfileOf(farms, todaysVisits, FarmId, today);
                records = visit is null ? [] : (await Repository.GetVisitRecordsAsync(visit.Id)).ToDictionary(record => record.CowId);
            }

            grid = DailyActions.Compute(cows, today, Thresholds);
        }
        catch (StorageUnavailableException exception)
        {
            error = exception.Message;
        }
    }

    // Filtrage d'affichage uniquement : une vache apparaît sous chacun de ses motifs.
    private IEnumerable<RegieItem> VisibleItems
    {
        get
        {
            var items = CowSearch.Filter(grid!.Items.Where(item => filter is null || item.Motives.Any(motive => motive.Action == filter)), search);
            return sortByNumber ? items.OrderBy(item => item.Cow.Id, StringComparer.Ordinal) : items;
        }
    }

    private VeterinarianProfile Vet => ShowcaseBuilder.DemoVeterinarian;

    private CowShowcase ShowFor(RegieItem item) => CowShowcaseBuilder.Build(item, today, Thresholds);

    private void Simulate() => message = "Démonstration : fonction simulée, aucune donnée envoyée.";

    private void OnSearch(ChangeEventArgs args) => search = args.Value?.ToString() ?? string.Empty;

    private IEnumerable<(RegieAction Action, int Count)> ActionCounts =>
        grid!.Items.SelectMany(item => item.Motives.Select(motive => motive.Action).Distinct())
            .GroupBy(action => action)
            .OrderBy(group => group.Key)
            .Select(group => (group.Key, group.Count()));

    private RegieItem? Selected => VisibleItems.FirstOrDefault(item => item.Cow.Id == selectedId) ?? VisibleItems.FirstOrDefault();

    private string Pressed(RegieAction? action) => filter == action ? "true" : "false";

    private CowVisitRecord? RecordFor(string cowId) => records.GetValueOrDefault(cowId);

    private CowVisitRecord EditableRecord(string cowId) => RecordFor(cowId) ?? CowVisitRecord.Empty(visit!.Id, cowId);

    private Task SaveResultAsync(string cowId, RegieAction action, ResultOutcome outcome) =>
        SaveAsync(EditableRecord(cowId).WithResult(action, outcome, TimeProvider.GetLocalNow()));

    private Task SaveNoteAsync(string cowId, string note) =>
        SaveAsync(EditableRecord(cowId).WithNote(note.Length > CowVisitRecord.MaxNoteLength ? note[..CowVisitRecord.MaxNoteLength] : note, TimeProvider.GetLocalNow()));

    // Enregistrement automatique à chaque saisie (story 7.3) ; en cas d'échec, la saisie reste affichée.
    private async Task SaveAsync(CowVisitRecord record)
    {
        records[record.CowId] = record;
        try
        {
            await Repository.SaveVisitRecordAsync(record);
            (saveError, saveStatus) = (null, $"Enregistré à {record.UpdatedAt:HH:mm}");
        }
        catch (StorageUnavailableException exception)
        {
            (saveError, saveStatus) = (exception.Message, null);
        }
    }

    private static string? OtherMotives(RegieItem item) =>
        item.Motives.Count > 1 ? $"Aussi : {string.Join(", ", item.Motives.Skip(1).Select(motive => RegieLabels.Action(motive.Action)))}." : null;

    private static IReadOnlyList<CowCardMetric> Metrics(CowShowcase show) =>
        [.. show.Measures.Select(measure => new CowCardMetric(measure.Label, measure.Value, measure.Alert))];
}
