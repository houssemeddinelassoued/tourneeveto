@page "/"
@using TourneeVeto.Ui.Data
@using TourneeVeto.Ui.Formatting
@inject ShowcaseProvider Provider

@* Accueil (maquettes design/stitch/tablette/accueil.png et web/tableau-de-bord.png). Les chiffres viennent du domaine
   (ShowcaseBuilder, DailyActions) ; la page ne fait que charger et afficher. Les boutons d'actions externes sont simulés. *@

<PageTitle>Accueil — TournéeVéto</PageTitle>

<section class="root" aria-labelledby="home-title" aria-busy="@(snapshot is null && error is null ? "true" : "false")">
    <header class="hero">
        <p class="eyebrow">@(snapshot is null ? string.Empty : ShowcaseLabels.LongDate(snapshot.Today))</p>
        <h1 class="title" id="home-title">
            <span class="only-mobile">Bonjour, @Vet.Name</span>
            <span class="only-desk">@Vet.ClinicName · @Vet.Name</span>
        </h1>

        @if (snapshot is not null)
        {
            <div class="only-desk hero-extra">
                <p class="hero-chips">
                    <span class="chip chip--primary">Poste fixe clinique</span>
                    <span class="chip chip--muted">Secteur : @Vet.Sector (rayon 45 km)</span>
                    <span class="chip chip--ok">Synchronisation @ShowcaseLabels.Time(snapshot.Day.LastSync) (fictive)</span>
                </p>
                <p class="subtitle">
                    Plan d'intervention et télémesures du @ShowcaseLabels.DayMonth(snapshot.Today) ·
                    @ShowcaseLabels.Count(snapshot.Day.Indicators.VisitsPlanned, "cheptel programmé", "cheptels programmés")
                </p>
                <div class="hero-actions">
                    <button type="button" class="button button--urgent" @onclick="Simulate">+ Urgence d'élevage</button>
                    <button type="button" class="button button--primary" @onclick="Simulate">Préparer tournée J+1</button>
                    <button type="button" class="button button--soft" @onclick="Simulate">Export Hebdo</button>
                </div>
            </div>
        }
    </header>

    <p class="demo" role="status">@message</p>

    @if (error is not null)
    {
        <p class="error" role="alert">@error</p>
    }
    else if (snapshot is null)
    {
        <p class="status">Chargement de l'accueil…</p>
    }
    else
    {
        <HomeMobile Snapshot="snapshot" OnSimulate="Simulate" />
        <HomeDesktop Snapshot="snapshot" OnSimulate="Simulate" />
    }
</section>

@code {
    private const string DemoMessage = "Démonstration : fonction simulée, aucune donnée envoyée.";

    private ShowcaseSnapshot? snapshot;
    private string? error;
    private string? message;

    private TourneeVeto.Domain.Showcase.VeterinarianProfile Vet =>
        snapshot?.Day.Veterinarian ?? TourneeVeto.Domain.Showcase.ShowcaseBuilder.DemoVeterinarian;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            snapshot = await Provider.LoadAsync();
        }
        catch (StorageUnavailableException exception)
        {
            error = exception.Message;
        }
    }

    private void Simulate() => message = DemoMessage;
}
