@page "/rapport"
@page "/rapport/{FarmId}"
@using System.Globalization
@using TourneeVeto.Domain.Biosecurity
@using TourneeVeto.Domain.Regie
@using TourneeVeto.Domain.Reports
@using TourneeVeto.Domain.Visits
@using TourneeVeto.Ui.Biosecurity
@using TourneeVeto.Ui.Data
@using TourneeVeto.Ui.Formatting
@using TourneeVeto.Ui.Platform
@inject DemoDataSeeder Seeder
@inject IVisitRepository Repository
@inject TimeProvider TimeProvider
@inject RegieThresholds Thresholds
@inject ReportPrinter Printer

@* Rapport de visite (maquettes design/stitch/*/rapport.png et rapports.png). Le contenu vient de VisitReports et de
   BiosecurityScore (TourneeVeto.Domain) ; la page charge, met en forme et lance l'impression (printReport.js). *@

<PageTitle>Rapport de visite — TournéeVéto</PageTitle>

<section class="root" aria-labelledby="report-title" aria-busy="@(report is null && error is null && !string.IsNullOrEmpty(FarmId) ? "true" : "false")">
    <header class="header">
        <p class="eyebrow">Synthèse de visite</p>
        <h1 class="title" id="report-title">Rapport de visite</h1>
        @if (farm is not null)
        {
            <p class="farm">@farm.Name · @farm.Municipality · @farm.CowCount vaches</p>
            <p class="date">Visite du @DateLabel</p>
        }
        <p class="disclaimer">@VisitReport.Disclaimer</p>
        @if (report is not null)
        {
            <button type="button" class="print" @onclick="PrintAsync">Imprimer / Exporter PDF</button>
        }
    </header>

    @if (string.IsNullOrEmpty(FarmId))
    {
        <FarmChooser BasePath="rapport" />
    }
    else if (error is not null)
    {
        <p class="error" role="alert">@error</p>
    }
    else if (report is null)
    {
        <p class="status">Chargement du rapport…</p>
    }
    else
    {
        @if (printError is not null)
        {
            <p class="error" role="alert">@printError</p>
        }

        @if (!hasVisit)
        {
            <p class="warning" role="status">Aucune visite prévue aujourd'hui pour cette ferme : aucun résultat n'a été saisi.</p>
        }

        <section class="block" aria-labelledby="regie-title">
            <h2 class="block-title" id="regie-title"><span class="step" aria-hidden="true">1</span> Constats de régie</h2>
            <p class="summary">@report.SeenCount vache(s) vue(s) · @report.NotSeenCount non vue(s) sur @report.Lines.Count dans la grille</p>
            @if (report.Lines.Count == 0)
            {
                <p class="status">Aucune action de régie pour cette visite.</p>
            }
            else
            {
                <table class="report-table">
                    <caption class="visually-hidden">Constats de régie par vache</caption>
                    <thead>
                        <tr>
                            <th scope="col">Vache</th>
                            <th scope="col">Motif</th>
                            <th scope="col">Résultat</th>
                            <th scope="col">Note</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in report.Lines)
                        {
                            <tr @key="line.Cow.Id">
                                <th scope="row">
                                    <span class="cow-id">@line.Cow.Id</span>
                                    <span class="cow-name">@line.Cow.Name</span>
                                </th>
                                <td class="motives">@Motives(line)</td>
                                <td class="result">
                                    @if (!line.IsSeen)
                                    {
                                        <text>Non vue</text>
                                    }
                                    else
                                    {
                                        @foreach (var result in line.Results)
                                        {
                                            <span class="result-item">@RegieLabels.Action(result.Action) : @(result.Outcome is { } outcome ? ResultLabels.For(result.Action, outcome) : "Non vue")</span>
                                        }
                                    }
                                </td>
                                <td class="note">@line.Note</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>

        <section class="block" aria-labelledby="bio-title">
            <h2 class="block-title" id="bio-title"><span class="step" aria-hidden="true">2</span> Indice de biosécurité</h2>
            @if (report.Biosecurity is not { } bio)
            {
                <p class="not-done" role="status">Bilan de biosécurité non réalisé</p>
            }
            else
            {
                <p class="global-score global-score--@BiosecurityLabels.Tone(bio.OverallLevel)">
                    <span class="global-value">@(bio.OverallScore?.ToString(CultureInfo.InvariantCulture) ?? "—")<span class="global-max"> / 100</span></span>
                    <span class="global-level">@BiosecurityLabels.Risk(bio.OverallLevel)</span>
                </p>
                <ul class="bio-sections" role="list">
                    @foreach (var section in bio.Sections)
                    {
                        <li class="bio-section bio-section--@BiosecurityLabels.Tone(section.Level)">
                            <span class="bio-section-name">@section.Section</span>
                            <span class="bio-section-score">@BiosecurityLabels.Score(section)</span>
                        </li>
                    }
                </ul>

                <h3 class="sub-title">Pratiques prioritaires</h3>
                @if (bio.PriorityPractices.Count == 0)
                {
                    <p class="status">Aucune pratique à améliorer.</p>
                }
                else
                {
                    <ol class="priority-list">
                        @foreach (var practice in bio.PriorityPractices)
                        {
                            <li>
                                <span class="priority-text">@practice.Text</span>
                                <span class="priority-meta">@practice.Section@(practice.IsCritical ? " · Point critique" : "")</span>
                            </li>
                        }
                    </ol>
                }
            }
        </section>
    }
</section>

@code {
    private static readonly CultureInfo FrenchCanada = CultureInfo.GetCultureInfo("fr-CA");

    private Farm? farm;
    private VisitReport? report;
    private string? error;
    private string? printError;
    private bool hasVisit;
    private DateOnly today;

    /// <summary>Identifiant de la ferme visitée ; vide sur /rapport, qui propose les fermes du jour.</summary>
    [Parameter]
    public string? FarmId { get; set; }

    private string DateLabel => today.ToString("d MMMM yyyy", FrenchCanada);

    protected override async Task OnParametersSetAsync()
    {
        (farm, report, error, printError, hasVisit) = (null, null, null, null, false);
        if (string.IsNullOrEmpty(FarmId))
        {
            return;
        }

        try
        {
            await Seeder.EnsureSeededAsync();
            today = DateOnly.FromDateTime(TimeProvider.GetLocalNow().DateTime);
            farm = (await Repository.GetFarmsAsync()).FirstOrDefault(candidate => candidate.Id == FarmId);
            if (farm is null)
            {
                error = "Ferme introuvable.";
                return;
            }

            var cows = await Repository.GetCowsByFarmAsync(FarmId);
            var visit = (await Repository.GetVisitsByDateAsync(today)).FirstOrDefault(candidate => candidate.FarmId == FarmId);
            hasVisit = visit is not null;
            IReadOnlyList<CowVisitRecord> records = visit is null ? [] : await Repository.GetVisitRecordsAsync(visit.Id);
            BiosecurityResult? biosecurity = null;
            if (visit is not null && await Repository.GetBiosecurityAsync(visit.Id) is { } saved)
            {
                biosecurity = BiosecurityScore.Compute(BiosecurityQuestionnaire.Default, saved.Answers);
            }

            report = VisitReports.Build(farm.Name, today, DailyActions.Compute(cows, today, Thresholds), records, biosecurity);
        }
        catch (StorageUnavailableException exception)
        {
            error = exception.Message;
        }
    }

    private async Task PrintAsync()
    {
        try
        {
            printError = null;
            await Printer.PrintAsync();
        }
        catch (Microsoft.JSInterop.JSException)
        {
            printError = "Impression impossible sur cet appareil.";
        }
    }

    private static string Motives(ReportLine line) =>
        line.Results.Count > 0
            ? string.Join(", ", line.Results.Select(result => RegieLabels.Action(result.Action)))
            : "Donnée à corriger";
}
